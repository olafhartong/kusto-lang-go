<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>KUSTO_BUILD</DefineConstants>
    <NoWarn>CS0649;CS8981</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Compatibility.cs" />
    <Compile Include="$(UpstreamRoot)/src/Kusto.Language/**/*.cs" Exclude="$(UpstreamRoot)/src/Kusto.Language/**/obj/**;$(UpstreamRoot)/src/Kusto.Language/**/bin/**" />
    <Compile Include="$(GeneratedRoot)/*.cs" />
  </ItemGroup>
</Project>
